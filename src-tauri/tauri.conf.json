{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "arenacoach-local",
  "version": "0.1.0",
  "identifier": "com.chris.arenacoach-local",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Arena Coach",
        "width": 1440,
        "height": 900,
        "minWidth": 400,
        "minHeight": 640,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
